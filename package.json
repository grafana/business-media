{
  "name": "business-media",
  "description": "Display Base64 encoded and URL media files",
  "version": "7.3.3",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "e2e": "playwright test",
    "levitate": "npx @grafana/levitate@latest is-compatible --path src/module.ts --target @grafana/data,@grafana/runtime,@grafana/ui",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "markdownlint": "markdownlint-cli2 AGENTS.md CHANGELOG.md README.md",
    "sign": "sign-plugin",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "start": "docker compose up --build grafana postgres pdf-loader",
    "stop": "docker compose down",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4 --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:dev": "npx playwright test --ui",
    "test:e2e:docker": "bash scripts/e2e-docker.sh",
    "typecheck": "tsc --noEmit",
    "upgrade": "npm upgrade --save"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/i18n": "12.4.4",
    "@grafana/plugin-e2e": "3.9.0",
    "@grafana/schema": "12.4.4",
    "@grafana/sign-plugin": "3.3.0",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.60.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.40",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/file-saver": "2.0.7",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/node": "24.12.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "13.0.1",
    "cspell": "10.0.1",
    "css-loader": "7.1.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "52.0.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "11.1.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.9.6",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.100.0",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.2",
    "webpack": "5.107.2",
    "webpack-cli": "6.0.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.4.4",
    "@grafana/runtime": "12.4.4",
    "@grafana/ui": "12.4.4",
    "@hello-pangea/dnd": "18.0.1",
    "buffer": "6.0.3",
    "file-saver": "2.0.5",
    "js-base64": "3.7.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-medium-image-zoom": "5.4.6",
    "react-zoom-pan-pinch": "3.7.0",
    "semver": "7.8.1",
    "tslib": "2.8.1",
    "uuid": "14.0.0"
  },
  "packageManager": "npm@11.16.0"
}
